# Biến môi trường kết nối Database SQL Server
PORT=5000
NODE_ENV=development

# Mật khẩu demo ('Password123@', 'admin', '123456') để chuyển nhanh tài khoản khi báo cáo.
# Mặc định BẬT khi NODE_ENV khác production; luôn TẮT khi NODE_ENV=production.
# Đặt false để tắt thủ công ở môi trường dev.
ALLOW_DEMO_PASSWORDS=true

# Khóa ký JWT. BẮT BUỘC khi NODE_ENV=production (tối thiểu 32 ký tự ngẫu nhiên).
# Khi để trống ở dev, hệ thống tự dùng khóa phát triển suy ra theo máy.
# Tạo khóa: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# JWT_SECRET=
# Thời hạn token (mặc định 30d ở dev, 8h ở production)
# JWT_EXPIRES_IN=8h

# Danh sách origin trình duyệt được gọi API, phân tách bằng dấu phẩy.
# Để trống ở dev: cho phép http://localhost:5173 và http://127.0.0.1:5173 (và cổng preview 4173).
# CORS_ORIGINS=http://localhost:5173

# Tên Server SQL trên máy bạn (Mặc định thường là (localdb)\mssqllocaldb hoặc .\SQLEXPRESS)
DB_SERVER=(localdb)\mssqllocaldb
DB_NAME=retail_spoilage_db
DB_TRUSTED_CONNECTION=true

# Nếu dùng tài khoản sa (SQL Server Authentication) thì điền bên dưới:
# DB_USER=sa
# DB_PASSWORD=your_password

# Google Gemini API Key cho Trợ lý AI 4 (tùy chọn). Để trống sẽ dùng Local Engine đọc SQL Server.
# Lấy key tại: https://aistudio.google.com/apikey
# GEMINI_API_KEY=
